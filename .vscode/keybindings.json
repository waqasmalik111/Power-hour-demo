[
  {
  "key": "cmd+shift+Y",
  "command": "workbench.action.tasks.runTask",
  "args": "Generate Code (prompt to file)",
  "when": "editorTextFocus"
},
  {
    "key": "cmd+alt+v",
    "command": "workbench.action.tasks.runTask",
    "args": "Validate Current File v3",
    "when": "editorHasSelection && (editorTextFocus || terminalFocus)"
  }
]


