[
  {
    "key": "cmd+alt+g",
    "command": "workbench.action.tasks.runTask",
    "args": "Generate Code (prompt) v3",
    "when": "editorTextFocus || terminalFocus"
  },
  {
    "key": "cmd+alt+v",
    "command": "workbench.action.tasks.runTask",
    "args": "Validate Current File v3",
    "when": "editorHasSelection && (editorTextFocus || terminalFocus)"
  }
]


