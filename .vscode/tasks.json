{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Code (prompt)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "scripts-for-codegen/generate.sh \"${input:genPrompt}\" \"${file}\""
      ],
      "problemMatcher": []
    },
    {
      "label": "Validate Current File",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "scripts-for-codegen/validate.sh \"${file}\""
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "genPrompt",
      "type": "promptString",
      "description": "Describe the code to generate",
      "default": "Write a Python function"
    }
  ]
}
