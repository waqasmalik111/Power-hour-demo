{
  "name": "devspaces-agent-extension",
  "displayName": "DevSpaces Agent Commands",
  "description": "Validate code, generate code, and deploy applications using your ReAct Agent backend.",
  "version": "0.0.2",
  "publisher": "your-org",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "main": "extension.js",
  "activationEvents": [
    "onCommand:agent.validateSelection",
    "onCommand:agent.generateCode",
    "onCommand:agent.deployToOpenShift"
  ],
  "contributes": {
    "configuration": {
      "title": "Agent",
      "properties": {
        "agent.route": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of your agent service (e.g. http://localhost:8080). If empty, the extension tries process.env.AGENT_ROUTE."
        },
        "agent.defaultLanguage": {
          "type": "string",
          "default": "python",
          "description": "Default language to send for validation/generation."
        }
      }
    },
    "commands": [
      { "command": "agent.validateSelection", "title": "Agent: Validate Selection" },
      { "command": "agent.generateCode", "title": "Agent: Generate Code" },
      { "command": "agent.deployToOpenShift", "title": "Agent: Deploy to OpenShift" }
    ],
    "menus": {
      "editor/context": [
        { "command": "agent.validateSelection", "when": "editorHasSelection", "group": "navigation@5" }
      ],
      "commandPalette": [
        { "command": "agent.validateSelection", "when": "editorTextFocus" },
        { "command": "agent.generateCode", "when": "editorTextFocus" },
        { "command": "agent.deployToOpenShift" }
      ]
    },
    "keybindings": [
      { "command": "agent.validateSelection", "key": "ctrl+alt+v", "mac": "cmd+alt+v", "when": "editorTextFocus && editorHasSelection" },
      { "command": "agent.generateCode", "key": "ctrl+alt+g", "mac": "cmd+alt+g", "when": "editorTextFocus" },
      { "command": "agent.deployToOpenShift", "key": "ctrl+alt+d", "mac": "cmd+alt+d" }
    ]
  },
  "dependencies": {
    "node-fetch": "^2.6.9"
  }
}